NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_api_key_here
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=your_map_id_here
GOOGLE_PLACES_API_KEY=your_server_only_places_key_here
NEXT_PUBLIC_SUPABASE_URL=your_project_url_here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
SUPABASE_ACCESS_TOKEN=your_personal_access_token_here
SUPABASE_DB_PASSWORD=your_database_password_here
SUPABASE_SECRET_KEY=your_server_only_secret_key_here
TOWNGAS_ACCESS_PASSWORD=your_server_only_project_password_here

# Signs you in as admin from the footer. Also what gates the command center and
# the guides that are still in development.
RECIPE_ADMIN_PASSWORD=your_server_only_admin_password_here

# --- Command center (/command-center) ---
# All server-side; none of these reach the browser. Add each in
# Vercel -> Settings -> Environment Variables (Production + Preview).

# Access control is the site's existing admin session — sign in from the footer
# with RECIPE_ADMIN_PASSWORD (above) and the dashboard appears. There is no
# separate command-center password. With no admin password set there is no
# valid session, so the route 404s rather than serving a calendar publicly.

# Google Calendar + Drive, read-only. Client id/secret come from Google Cloud
# Console -> Credentials -> OAuth client ID (Web application). Mint the refresh
# token once with: node scripts/get-google-refresh-token.mjs
GOOGLE_CLIENT_ID=your_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_oauth_client_secret_here
GOOGLE_REFRESH_TOKEN=your_refresh_token_here

# Vercel deployment status. vercel.com/account/tokens, read access is enough.
VERCEL_API_TOKEN=your_vercel_token_here
VERCEL_TEAM_ID=your_vercel_team_id_here

# TomTom geocoding, routing and map tiles. developer.tomtom.com — the free tier
# covers a personal dashboard comfortably.
TOMTOM_API_KEY=your_tomtom_key_here
